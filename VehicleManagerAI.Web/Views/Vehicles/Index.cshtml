@model IReadOnlyList<Vehicle>
@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Vehicles</h1>
        <p class="text-muted mb-0">Classic MVC CRUD against the same in-memory inventory the AI chat uses.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add vehicle</a>
</div>

@if (TempData["Status"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Year</th>
            <th>Make</th>
            <th>Model</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Count == 0)
    {
        <tr>
            <td colspan="5" class="text-muted">No vehicles yet. Create one here or ask the AI chat to add one.</td>
        </tr>
    }
    @foreach (var vehicle in Model)
    {
        <tr>
            <td>@vehicle.Id</td>
            <td>@vehicle.Year</td>
            <td>@vehicle.Make</td>
            <td>@vehicle.Model</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@vehicle.Id">Details</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@vehicle.Id">Edit</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@vehicle.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
